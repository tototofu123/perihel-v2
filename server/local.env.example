# Perihel sync server — deployment config template.
# Copy to server/local.env (gitignored) and fill in YOUR values after
# following docs/SELF-HOST.md. Never commit local.env.

PERIHEL_SYNC_URL=https://YOUR-VM-DOMAIN
PERIHEL_SYNC_TOKEN=<openssl rand -hex 32 from the VM's /opt/perihel-sync/token>
PERIHEL_NTFY_TOPIC=perihel-<openssl rand -hex 4>
PERIHEL_GCP_PROJECT=your-gcp-project
PERIHEL_GCP_ZONE=us-west1-b
PERIHEL_GCP_INSTANCE=perihel-sync
PERIHEL_BILLING_ACCOUNT=your-billing-account-id
PERIHEL_BUDGET_ID=your-budget-id
